# Phase 8B -- backend-only environment variables.
#
# Copy this file to `backend/.env` (already git-ignored -- see the
# repository's root .gitignore's `.env` / `.env.*` / `!.env.example`
# pattern, which already covers this file correctly) and fill in real
# values there. NEVER commit backend/.env, NEVER place any of these
# values in frontend/.env or any VITE_-prefixed variable -- see
# reports/phase8a_supabase_multiuser_architecture.md Section 13 for why
# a privileged, server-side credential must never reach shipped browser
# code.

# Postgres connection string for the Supabase-hosted database. Read by
# backend/api/dependencies.py: when set (non-empty), the application
# persists procurement runs to this Postgres database via
# backend/persistence/supabase_repository.py, instead of the default
# local SQLite file. Leave this blank/unset for local offline development
# and for the automated test suite -- both continue to use SQLite by
# design (see backend/api/dependencies.py's own docstring); the test
# suite never reads this variable.
DATABASE_URL=

# --- Phase 8D: JWT verification (backend/security/jwt_verifier.py). ---

# The same Supabase project's base URL, e.g. https://xxxxxxxx.supabase.co
# (no trailing slash needed either way). Read by
# backend/security/jwt_verifier.py to derive both the project's JWKS
# endpoint (<SUPABASE_URL>/auth/v1/.well-known/jwks.json, used to fetch the
# public keys access tokens are verified against) and its expected token
# issuer (<SUPABASE_URL>/auth/v1). Required for any authenticated request
# to succeed; the automated test suite never reads this real value -- it
# sets its own fake SUPABASE_URL and mocks the JWKS fetch (see
# tests/security/). Safe to be the same value as a frontend
# VITE_SUPABASE_URL if one is already configured -- this is a project
# identifier, not a secret.
SUPABASE_URL=

# Optional. Overrides the `aud` claim access tokens are checked against.
# Every standard Supabase project issues "authenticated" as the audience
# for a signed-in user's access token, so this normally does not need to
# be set at all -- backend/security/jwt_verifier.py already defaults to
# "authenticated" when this is unset/blank.
# SUPABASE_JWT_AUDIENCE=

# Reserved for a LATER phase (Phase 8F, user-owned persistence) -- NOT
# read by any code as of Phase 8D. Left commented out until that phase
# actually needs a privileged, RLS-bypassing service-role connection;
# uncommenting it now would have no effect.
# SUPABASE_SERVICE_ROLE_KEY=

# NOTE (Phase 8D architectural note -- see
# reports/phase8d_fastapi_jwt_authentication.md, section "Architectural
# ambiguity resolved"): the SUPABASE_JWT_SECRET variable Phase 8B reserved
# here has been intentionally removed rather than activated. That name
# implies the legacy HS256/shared-secret verification mechanism some older
# Supabase projects use; this phase instead implements the JWKS-based
# asymmetric (RS256/ES256) verification architecture the Phase 8D task
# explicitly and exclusively specifies, which needs only SUPABASE_URL
# above -- no shared secret is ever read, stored, or required.
