# Phase 7A -- copy this file to `.env` (git-ignored, developer-local) and
# adjust the value to match wherever you are running the FastAPI backend
# (see the "Commands to run frontend/backend" section of
# reports/phase7a_frontend_architecture_and_setup.md).
#
# Example: run the backend with
#   uvicorn backend.api.main:app --reload --port 8731
# then this value should be:
VITE_API_BASE_URL=http://127.0.0.1:8731
